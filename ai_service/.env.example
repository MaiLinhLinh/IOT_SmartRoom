# ============ BACKEND ============
# IP laptop chạy backend (hoặc URL Cloudflare Tunnel nếu AI ở mạng khác)
BACKEND_URL=http://localhost:8006
# Điền nếu .env của backend có đặt các key này
PEOPLE_API_KEY=
AI_API_KEY=

# ============ CAMERA ============
# esp32 | backend | webcam:0 | đường dẫn ảnh/video | URL JPEG
#   esp32   : AI cùng mạng LAN với ESP32-CAM → lấy thẳng http://CAM_IP:CAM_PORT/capture
#   backend : AI ở mạng khác → lấy qua BACKEND_URL/api/camera/snapshot
CAMERA_SOURCE=esp32
CAM_IP=10.18.3.98
CAM_PORT=80

# ============ YOLO ============
# tự tải lần đầu; yolo11s.pt chính xác hơn nhưng chậm hơn
YOLO_MODEL=yolo11n.pt
# ngưỡng tin cậy
YOLO_CONF=0.40
YOLO_IMGSZ=640
# trống = tự chọn, cpu, hoặc 0 (GPU)
YOLO_DEVICE=
COUNT_INTERVAL_SECONDS=2
# trung vị của 5 lần đếm gần nhất
SMOOTH_WINDOW=5
# số người không đổi vẫn gửi lại mỗi 10s
PEOPLE_HEARTBEAT_SECONDS=10
# vd: logs/last_frame.jpg để lưu ảnh có khung người
DEBUG_FRAME_PATH=

# ============ GEMINI ============
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2-flash-lite
# để trống nếu model báo lỗi thinking
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=30

# ============ QUYẾT ĐỊNH ============
# đọc /api/ai/context mỗi 5s
DECISION_CHECK_SECONDS=5
# 2 lần gọi Gemini cách nhau tối thiểu
LLM_MIN_INTERVAL_SECONDS=10
# không có thay đổi vẫn đánh giá lại sau 2 phút
LLM_MAX_INTERVAL_SECONDS=120
# nhiệt độ lệch >= 0.5°C mới gọi lại
TEMP_DELTA=0.5
# độ ẩm lệch >= 5% mới gọi lại
HUMIDITY_DELTA=5
# số người cũ hơn 60s coi như "không rõ"
PEOPLE_STALE_SECONDS=60
# cảm biến cũ hơn 60s thì không ra quyết định
SENSOR_STALE_SECONDS=60
DECISION_LOG_PATH=logs/decisions.jsonl
DRY_RUN=false

# ============ HỒ SƠ THIẾT BỊ & SỞ THÍCH (device_profile.py) ============
# Đây là thông tin NGƯỜI DÙNG sẽ nhập trên app sau này. Thứ tự ưu tiên:
#   mặc định trong code  →  các dòng dưới đây  →  backend /api/ai/context "config" (nếu backend có)
# Bỏ trống / xoá dòng = dùng mặc định. In mô tả đầy đủ: python device_profile.py
#
# Công suất điện từng quạt (W): 1 số cho cả 3 quạt, hoặc 3 số "quạt1,quạt2,quạt3"
FAN_POWER_W=45,45,45
# Quạt nào dùng được (1 = có, 0 = hỏng/không có)
FANS_AVAILABLE=1,1,1
# Phòng có điều hòa không
AC_AVAILABLE=true
# Công suất ĐIỆN điều hòa (W, mục Input trên nhãn, không phải BTU). 1 HP ~750-900, 1.5 HP ~1100-1300
AC_POWER_W=900
# Nhiệt độ cảm nhận tối đa mong muốn (°C). Thấp hơn = mát hơn, tốn điện hơn
COMFORT_MAX_TEMP=26.0
# Khoảng nhiệt độ đặt điều hòa cho phép (°C)
AC_MIN_TEMP=20
AC_SET_MAX=28

# ============ THAM SỐ KỸ THUẬT CỦA MÔ HÌNH (rules.py) — nhóm phát triển chỉnh ============
# Mỗi 1°C đặt cao hơn, điều hòa giảm ~6% điện
AC_SAVING_PER_DEGREE=0.06
# Hiệu ứng làm mát của 1, 2, 3 quạt (°C)
FAN_COOLING_EFFECT=1.5,2.5,3.0
# Độ ẩm (%) từ mức này coi là rất ẩm: quạt kém hiệu quả, ưu tiên AC hút ẩm
HUMID_RH=80
# Biên trễ chống bật/tắt liên tục (°C)
HYSTERESIS=0.5
# Phòng nóng hơn nhiệt độ đặt >= 2°C thì bật hết quạt để mát nhanh
PULLDOWN_DELTA=2.0
# AC đang chạy chỉ tắt khi phòng mát hơn nhiệt độ đặt >= 1°C (nếu không biết nhiệt độ lúc trước khi bật AC)
AC_OFF_MARGIN=1.0
# Bảo vệ máy nén: AC bật tối thiểu 10 phút, tắt tối thiểu 5 phút
AC_MIN_ON_SECONDS=600
AC_MIN_OFF_SECONDS=300
# Phòng trống: tắt quạt ngay, giữ AC thêm 3 phút rồi tắt
EMPTY_AC_GRACE_SECONDS=180
# Nhiệt độ/độ ẩm "trước khi bật AC" dùng để đánh giá tắt AC trong tối đa 30 phút
NATURAL_TEMP_TTL_SECONDS=1800
# Cách dùng "truyền thống" để so sánh mức tiết kiệm trong log: chỉ AC ở nhiệt độ này
BASELINE_AC_TEMP=25

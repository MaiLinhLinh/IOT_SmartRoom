 # Khoảng cách 2 log lớn hơn giá trị này (giờ) → bỏ qua, không tính điện
 MAX_INTERVAL_HOURS = 1.0
 
+# Công suất điều hòa phụ thuộc nhiệt độ đặt (khớp với mô hình của ai_service/rules.py):
+#   P(T) = P_danh_định × max(0.4, 1 − 0.06 × (T − 24))
+# power_watts người dùng nhập được coi là công suất khi đặt 24°C; đặt cao hơn 1°C giảm ~6%.
+AC_REFERENCE_TEMP = 24
+AC_SAVING_PER_DEGREE = 0.06
+AC_MIN_FACTOR = 0.4
+
+
+def ac_power_factor(ac_temp: Optional[int]) -> float:
+    """Hệ số công suất điều hòa theo nhiệt độ đặt (24°C → 1.0, 26°C → 0.88, 28°C → 0.76)."""
+    if ac_temp is None:
+        return 1.0
+    return max(AC_MIN_FACTOR, 1.0 - AC_SAVING_PER_DEGREE * (ac_temp - AC_REFERENCE_TEMP))
+
 
